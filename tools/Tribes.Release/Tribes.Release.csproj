<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Publishes game releases to the resource repository's GitHub releases and checks them the way
    the game does (docs/UPDATES.md). Reads tokens and the signing key only at run time.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Tribes.Release</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tribes.Update.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tribes.Update\Tribes.Update.csproj" />
  </ItemGroup>

</Project>
