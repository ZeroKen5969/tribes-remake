<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the client's world view scene code (client/src/World/Scene, engine independent): the
    tribe colours, floating numbers, endless maps, terrain tiling and minimap; with the original
    repository in original/ also every dev snapshot (original/reference/snapshots) drawn by it
    against the original's frame (original/reference/frames, written by
    original/tools/Tribes.DevSnapshots/reference.sh), arcs and smooth motion.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tribes.Core\Tribes.Core.csproj" />
    <ProjectReference Include="..\..\src\Tribes.Graphics\Tribes.Graphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\client\src\World\Scene\**\*.cs" Link="Scene\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The tests on the dev snapshots, worlds of the original's maps (in Original/), build only when the original repository is cloned into original/. -->
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\..\original\reference\snapshots')">
    <Compile Remove="Original\**" />
  </ItemGroup>

</Project>
