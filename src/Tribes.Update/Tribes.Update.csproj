<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In-game updates (docs/UPDATES.md): finds new versions in the GitHub releases of the resource
    repository, verifies the signed manifest, downloads and checks the files, and prepares content
    packs and app updates. Engine independent: the Godot client passes its user data paths and the
    platform installer. Same quality rules as Tribes.Core.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Tribes.Update</RootNamespace>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tribes.Update.Tests" />
    <!-- Public keys the client trusts for manifest signatures; written by `Tribes.Release keygen`. -->
    <EmbeddedResource Include="UpdateKeys.json" LogicalName="Tribes.Update.UpdateKeys.json" />
    <!-- The script that swaps in a Windows app update after the game exits. -->
    <EmbeddedResource Include="WindowsSwap.ps1" LogicalName="Tribes.Update.WindowsSwap.ps1" />
  </ItemGroup>

  <!--
    Update access embedded at build time. The repository name and the read-only token come from
    the secrets file (default secrets/github.json) and are written, the token masked, into a C#
    file under obj/, never into the source tree. Without the secrets file (or with
    TribesUpdateEmbedToken=false) the build embeds nothing and update checks report "not configured".
    Masking only keeps the token out of plain-text searches of the binary; it can still be extracted.
  -->
  <PropertyGroup>
    <TribesUpdateSecretsFile Condition="'$(TribesUpdateSecretsFile)' == ''">$(MSBuildThisFileDirectory)..\..\secrets\github.json</TribesUpdateSecretsFile>
    <TribesUpdateEmbedToken Condition="'$(TribesUpdateEmbedToken)' == ''">true</TribesUpdateEmbedToken>
  </PropertyGroup>

  <UsingTask TaskName="TribesWriteEmbeddedAccess" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SecretsFile ParameterType="System.String" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string repo = "";
        byte[] data = new byte[0];
        byte[] mask = new byte[0];
        if (!string.IsNullOrEmpty(SecretsFile) && File.Exists(SecretsFile))
        {
            string json = File.ReadAllText(SecretsFile);
            Match repoMatch = Regex.Match(json, "\"repo\"\\s*:\\s*\"([^\"\\\\]*)\"");
            Match tokenMatch = Regex.Match(json, "\"readToken\"\\s*:\\s*\"([^\"\\\\]*)\"");
            if (repoMatch.Success) repo = repoMatch.Groups[1].Value;
            if (tokenMatch.Success && tokenMatch.Groups[1].Value.Length > 0)
            {
                // Same scheme as TokenMask in the library: XOR with a 32-byte mask and the position.
                byte[] plain = Encoding.UTF8.GetBytes(tokenMatch.Groups[1].Value);
                using (SHA256 sha = SHA256.Create())
                {
                    mask = sha.ComputeHash(Encoding.UTF8.GetBytes("tribes-update-mask:" + tokenMatch.Groups[1].Value));
                }
                data = new byte[plain.Length];
                for (int i = 0; i < plain.Length; i++)
                {
                    data[i] = (byte)(plain[i] ^ mask[i % mask.Length] ^ (byte)((i * 0x9D) + 0x3B));
                }
            }
            Log.LogMessage(MessageImportance.Normal, "Tribes.Update: embedded update access from the secrets file (token present: " + (data.Length > 0) + ").");
        }
        else
        {
            Log.LogMessage(MessageImportance.Normal, "Tribes.Update: no secrets file; update access is not embedded.");
        }

        StringBuilder text = new StringBuilder();
        text.Append("// <auto-generated/>\n");
        text.Append("// Written at build time from the secrets file. Do not edit or commit.\n");
        text.Append("namespace Tribes.Update;\n\n");
        text.Append("internal static class EmbeddedAccessData\n{\n");
        text.Append("    internal const string Repository = \"").Append(repo.Replace("\\", "").Replace("\"", "")).Append("\";\n");
        text.Append("    internal static byte[] Token() => new byte[] { ").Append(string.Join(", ", data.Select(b => "0x" + b.ToString("X2")))).Append(" };\n");
        text.Append("    internal static byte[] Mask() => new byte[] { ").Append(string.Join(", ", mask.Select(b => "0x" + b.ToString("X2")))).Append(" };\n");
        text.Append("}\n");
        string content = text.ToString();
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != content)
        {
            File.WriteAllText(OutputFile, content);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="TribesGenerateEmbeddedAccess" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_TribesAccessFile>$(IntermediateOutputPath)EmbeddedAccessData.g.cs</_TribesAccessFile>
      <_TribesAccessSecrets Condition="'$(TribesUpdateEmbedToken)' == 'true'">$(TribesUpdateSecretsFile)</_TribesAccessSecrets>
    </PropertyGroup>
    <TribesWriteEmbeddedAccess SecretsFile="$(_TribesAccessSecrets)" OutputFile="$(_TribesAccessFile)" />
    <ItemGroup>
      <Compile Include="$(_TribesAccessFile)" />
      <FileWrites Include="$(_TribesAccessFile)" />
    </ItemGroup>
  </Target>

</Project>
