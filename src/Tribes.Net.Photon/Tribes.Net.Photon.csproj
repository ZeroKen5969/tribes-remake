<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Internet play over Photon Realtime (docs/NETWORK.md): PhotonTransport and PhotonRoomBrowser
    implement the transport interfaces of Tribes.Net, so the sessions run unchanged. Only this
    project references the Photon SDK (third_party/photon). Same quality rules as Tribes.Net.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Tribes.Net.Photon</RootNamespace>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tribes.Net.Photon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tribes.Net\Tribes.Net.csproj" />
    <ProjectReference Include="..\..\third_party\photon\PhotonRealtime\PhotonRealtime.csproj" />
    <Reference Include="PhotonClient">
      <HintPath>..\..\third_party\photon\lib\netstandard2.0\PhotonClient.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    The Photon AppId embedded at build time, as the update access is (src/Tribes.Update): read
    from the secrets file (default secrets/photon.json, key appIdRealtime) and written, masked,
    into a C# file under obj/, never into the source tree. Without the secrets file (or with
    TribesPhotonEmbedAppId=false) nothing is embedded and internet play reports "not configured".
    Masking only keeps the AppId out of plain-text searches of the binary; it can still be extracted.
  -->
  <PropertyGroup>
    <TribesPhotonSecretsFile Condition="'$(TribesPhotonSecretsFile)' == ''">$(MSBuildThisFileDirectory)..\..\secrets\photon.json</TribesPhotonSecretsFile>
    <TribesPhotonEmbedAppId Condition="'$(TribesPhotonEmbedAppId)' == ''">true</TribesPhotonEmbedAppId>
  </PropertyGroup>

  <UsingTask TaskName="TribesWriteEmbeddedPhotonAppId" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SecretsFile ParameterType="System.String" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        byte[] data = new byte[0];
        byte[] mask = new byte[0];
        if (!string.IsNullOrEmpty(SecretsFile) && File.Exists(SecretsFile))
        {
            string json = File.ReadAllText(SecretsFile);
            Match appIdMatch = Regex.Match(json, "\"appIdRealtime\"\\s*:\\s*\"([^\"\\\\]*)\"");
            if (appIdMatch.Success && appIdMatch.Groups[1].Value.Trim().Length > 0)
            {
                // Same scheme as AppIdMask in the library: XOR with a 32-byte mask and the position.
                string appId = appIdMatch.Groups[1].Value.Trim();
                byte[] plain = Encoding.UTF8.GetBytes(appId);
                using (SHA256 sha = SHA256.Create())
                {
                    mask = sha.ComputeHash(Encoding.UTF8.GetBytes("tribes-photon-mask:" + appId));
                }
                data = new byte[plain.Length];
                for (int i = 0; i < plain.Length; i++)
                {
                    data[i] = (byte)(plain[i] ^ mask[i % mask.Length] ^ (byte)((i * 0x9D) + 0x3B));
                }
            }
            Log.LogMessage(MessageImportance.Normal, "Tribes.Net.Photon: read the secrets file (AppId present: " + (data.Length > 0) + ").");
        }
        else
        {
            Log.LogMessage(MessageImportance.Normal, "Tribes.Net.Photon: no secrets file; no Photon AppId is embedded.");
        }

        StringBuilder text = new StringBuilder();
        text.Append("// <auto-generated/>\n");
        text.Append("// Written at build time from the secrets file. Do not edit or commit.\n");
        text.Append("namespace Tribes.Net.Photon;\n\n");
        text.Append("internal static class EmbeddedPhotonData\n{\n");
        text.Append("    internal static byte[] AppId() => new byte[] { ").Append(string.Join(", ", data.Select(b => "0x" + b.ToString("X2")))).Append(" };\n");
        text.Append("    internal static byte[] Mask() => new byte[] { ").Append(string.Join(", ", mask.Select(b => "0x" + b.ToString("X2")))).Append(" };\n");
        text.Append("}\n");
        string content = text.ToString();
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != content)
        {
            File.WriteAllText(OutputFile, content);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="TribesGenerateEmbeddedPhotonAppId" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_TribesPhotonFile>$(IntermediateOutputPath)EmbeddedPhotonData.g.cs</_TribesPhotonFile>
      <_TribesPhotonSecrets Condition="'$(TribesPhotonEmbedAppId)' == 'true'">$(TribesPhotonSecretsFile)</_TribesPhotonSecrets>
    </PropertyGroup>
    <TribesWriteEmbeddedPhotonAppId SecretsFile="$(_TribesPhotonSecrets)" OutputFile="$(_TribesPhotonFile)" />
    <ItemGroup>
      <Compile Include="$(_TribesPhotonFile)" />
      <FileWrites Include="$(_TribesPhotonFile)" />
    </ItemGroup>
  </Target>

</Project>
